# ==============================================================================
# CAP AI – Backend Environment Configuration
# Current Affairs Preparation with AI
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Groq AI Integration (xAI / OpenAI compatible format)
# Sign up at https://console.groq.com and obtain an API key.
# Recommended Models:
#   - llama-3.3-70b-versatile (Large context, excellent reasoning for exams)
#   - llama-3.1-8b-instant (Ultra fast, lightweight)
#   - mixtral-8x7b-32768
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas)
# Sign up at https://www.mongodb.com/atlas/database
# Replace with your cluster connection URI:
# mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cap_ai?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/cap_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# Generate a strong 256-bit random string for signing JSON Web Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=cap_ai_super_secret_jwt_key_competitive_exams_2026_xyz987
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. Email Service Configuration (Nodemailer for OTPs)
# Used for sending 6-digit email verification and password reset OTPs.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=CAP AI Support <noreply@capai.edu>

# ------------------------------------------------------------------------------
# 5. External News API (Optional)
# For fetching live news feeds (e.g., NewsAPI.org or GNews.io)
# ------------------------------------------------------------------------------
NEWS_API_KEY=
